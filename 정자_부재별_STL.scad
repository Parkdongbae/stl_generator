    multmatrix([[1,0,0,1350],[0,1,0,1350],[0,0,1,2830],[0,0,0,1]]) cube([100,300,244],center=true);
    multmatrix([[1,0,0,1350],[0,1,0,1350],[0,0,1,2830],[0,0,0,1]]) cube([300,100,244],center=true);
    multmatrix([[1,0,0,1445],[0,1,0,1350],[0,0,1,450],[0,0,0,1]]) cube([90,50,100],center=true);
    multmatrix([[1,0,0,1255],[0,1,0,1350],[0,0,1,450],[0,0,0,1]]) cube([90,50,100],center=true);
    multmatrix([[1,0,0,1350],[0,1,0,1445],[0,0,1,450],[0,0,0,1]]) cube([50,90,100],center=true);
