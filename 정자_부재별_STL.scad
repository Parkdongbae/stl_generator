// 사모정(四隅亭) 부재별 STL 출력용 OpenSCAD 코드 — 웹앱과 같은 모델 데이터(model.js)에서 자동 생성
// 단위 mm / 절대좌표계: 원점 = 평면 중심, z=0 = 기단 윗면, z는 위쪽
// 모든 부재는 조립된 최종 위치의 절대좌표로 만들어지므로, 따로 저장한 STL을 함께 불러오면 정자 모양으로 그대로 맞춰집니다.
// 맞춤·짜임(사갈, 반턱, 주먹장, 장부와 장부홈, 그렝이, 착고 자리 등)은 모두 실제로 깎아 낸 형상으로 들어 있습니다.
//
// 사용법 (부재 종류별로 저장):
//   openscad -D 'PART="03_gidung"' -o 03_gidung.stl jeongja.scad
// 같은 종류 중 1개만 저장 (IDX = 0부터, 번호는 아래 주석의 순서):
//   openscad -D 'PART="13_dori"' -D 'IDX=2' -o dori3.stl jeongja.scad
// 전체를 종류별로 저장 (bash):
//   for p in 01_gidan 02_choseok 03_gidung 04_dongbari 05_janggwi 06_donggwi 07_changbang 08_ikgong 09_judu 10_hwaban 11_janghyeo 12_bo 13_dori 14_daegong 15_chunyeo 16_seokkarae 17_seonja 18_sarae 19_chomaegi 20_buyeon 21_gaepan 22_jeoksim 23_amkiwa 24_sukiwa 25_maru 26_jeolbyeong 27_cheongpan 28_nangan; do
//     openscad -D "PART=\"$p\"" -o $p.stl jeongja.scad; done
// ※ 기와(23_amkiwa, 24_sukiwa)는 개수가 많아 렌더링이 오래 걸립니다. 면별로 IDX=0~3을 따로 저장하세요.
// ※ 파일을 열면 자동 미리보기(F5)가 전체를 그립니다. 처음 열 때 몇십 초 걸릴 수 있습니다. 내보내기는 F6(렌더) 후 STL 저장.
// ※ OpenSCAD 2021.01에서 확인했습니다. 최신 개발판(Manifold 엔진)을 쓰면 훨씬 빠릅니다.
//
// 부재 종류 목록:
//   01_gidan  기단 (3개)
//   02_choseok  초석 (4개)
//   03_gidung  기둥 (4개)
//   04_dongbari  동바리 (20개)
//   05_janggwi  장귀틀 (9개)
//   06_donggwi  동귀틀 (28개)
//   07_changbang  창방 (4개)
//   08_ikgong  익공 (8개)
//   09_judu  주두 (8개)
//   10_hwaban  화반 (4개)
//   11_janghyeo  장혀 (4개)
//   12_bo  보(대들보) (1개)
//   13_dori  도리 (4개)
//   14_daegong  동자대공·찰주 (2개)
//   15_chunyeo  추녀 (4개)
//   16_seokkarae  서까래(평연) (32개)
//   17_seonja  선자연 (32개)
//   18_sarae  사래 (4개)
//   19_chomaegi  초매기(평고대) (4개)
//   20_buyeon  부연 (64개)
//   21_gaepan  개판·이매기·연함 (16개)
//   22_jeoksim  적심·보토 (8개)
//   23_amkiwa  암키와 (4개)
//   24_sukiwa  수키와 (4개)
//   25_maru  추녀마루 (4개)
//   26_jeolbyeong  절병통 (1개)
//   27_cheongpan  청판(마루널) (84개)
//   28_nangan  계자난간 (60개)

PART = "all";   // "all" 또는 위 목록의 부재 이름
IDX  = -1;      // -1: 그 종류 전부, 0 이상: 해당 번호 1개만
function on(i) = IDX < 0 || IDX == i;
module P(n){ if (PART=="all" || PART==n) children(); }

